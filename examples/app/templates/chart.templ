package templates

import "github.com/geoffjay/templ-charts/charts/htmx"

// ChartCardProps is one demo card: title, description, the chart instance id,
// and the pre-rendered SVG string to inject. The SVG is rendered server-side
// by the htmx handler (full render) and injected as raw HTML.
type ChartCardProps struct {
	ID          string
	Title       string
	Description string
	SVG         string
	Interactive bool
}

// ChartCard renders one demo card: the visual chrome (card box, heading,
// description) is the app's own styling, and the chart itself is mounted via
// htmx.Mount — the library component that emits the #chart-<id> container, the
// #tooltip-<id> swap target, and the mouseleave reset wiring. Passing
// Class:"chart" attaches the demo's responsive sizing CSS to the container.
// This deliberately consumes the public API rather than hand-rolling the
// plumbing, so the demo demonstrates how a real consumer wires interactivity.
templ ChartCard(props ChartCardProps) {
	<div class="card">
		<h2>{ props.Title }</h2>
		<p>{ props.Description }</p>
		@htmx.Mount(htmx.MountProps{
			ID:          props.ID,
			SVG:         props.SVG,
			Interactive: props.Interactive,
			Class:       "chart",
		})
	</div>
}

// IndexPage renders the home page: an intro + a list of links to each demo
// page.
type IndexPageProps struct {
	Pages []IndexLink
}

// IndexLink is one entry on the home page.
type IndexLink struct {
	Href        string
	Title       string
	Description string
}

templ IndexPage(props IndexPageProps) {
	<p class="intro">
		templ-charts is a Go library wrapping nivo's chart concepts as templ
		components generating server-side SVG. This demo app shows thirteen
		chart families — bar, line, pie, heatmap, waffle, calendar, radar,
		radial-bar, scatterplot, stream, bullet, funnel, and box plot — with a
		hybrid interactivity model: ephemeral hover (tooltips, crosshair) runs
		client-side from data attributes, while state changes (series toggle,
		active arc) use HTMX.
	</p>
	<ul class="list">
		for _, p := range props.Pages {
			<li>
				<a href={ p.Href }>{ p.Title }</a>
				<p>{ p.Description }</p>
			</li>
		}
	</ul>
}

// DemosPage renders a demo page (bar/line/pie): an intro line + a responsive
// grid of ChartCards.
type DemosPageProps struct {
	Intro string
	Cards []ChartCardProps
}

templ DemosPage(props DemosPageProps) {
	<p class="intro">{ props.Intro }</p>
	<div class="grid">
		for _, card := range props.Cards {
			@ChartCard(card)
		}
	</div>
}

// PaletteCardProps is one palette tile on the /palettes page: the palette
// display metadata, a row of swatch hex colors, and the pre-rendered chart SVG
// using that palette.
type PaletteCardProps struct {
	ID             string
	Name           string
	Kind           string
	Group          string
	ColorblindSafe bool
	Swatch         []string
	SVG            string
}

// PaletteCard renders one palette: a heading with kind/group tags, a swatch
// strip, and a bar chart colored by the palette.
templ PaletteCard(props PaletteCardProps) {
	<div class="card">
		<h2>
			{ props.Name }
			<span class="tag">{ props.Kind }</span>
			<span class="tag">{ props.Group }</span>
			if props.ColorblindSafe {
				<span class="tag tag-cb">colorblind-safe</span>
			}
		</h2>
		<p><code>{ props.ID }</code></p>
		<div class="swatches">
			for _, c := range props.Swatch {
				<span class="swatch" style={ "background:" + c } title={ c }></span>
			}
		</div>
		<div class="chart">
			@templ.Raw(props.SVG)
		</div>
	</div>
}

// PaletteGalleryPageProps is the input to the palette gallery page.
type PaletteGalleryPageProps struct {
	Intro string
	Cards []PaletteCardProps
}

templ PaletteGalleryPage(props PaletteGalleryPageProps) {
	<p class="intro">{ props.Intro }</p>
	<div class="grid">
		for _, card := range props.Cards {
			@PaletteCard(card)
		}
	</div>
}
