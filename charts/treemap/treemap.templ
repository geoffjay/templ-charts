package treemap

import "github.com/geoffjay/templ-charts/charts/core"

// Treemap renders a complete treemap SVG: dimensions → UseTreemap → nodes layer
// → SvgWrapper. Mirrors @nivo/treemap. Static render; per-node hover tooltips
// are available via Interactive (charts/interact).
templ Treemap(props TreemapProps) {
	{{ props = applyDefaults(props) }}
	{{ dims := core.UseDimensions(props.Width, props.Height, props.Margin) }}
	{{ props.Width = dims.InnerWidth }}
	{{ props.Height = dims.InnerHeight }}
	{{ result := UseTreemap(props) }}
	{{ theme := resolveTheme(props.Theme) }}
	@core.SvgWrapper(core.SvgWrapperProps{
		Width:           dims.OuterWidth,
		Height:          dims.OuterHeight,
		Margin:          dims.Margin,
		Background:      themeBackground(theme),
		Role:            props.Role,
		AriaLabel:       props.AriaLabel,
		AriaLabelledBy:  props.AriaLabelledBy,
		AriaDescribedBy: props.AriaDescribedBy,
		Title:           props.Title,
		Desc:            props.Desc,
		IsFocusable:     props.IsFocusable,
		Responsive:      props.Responsive,
	}, renderNodes(props, result, theme))
}
