package bar

import "github.com/geoffjay/templ-charts/charts/legends"

// BarLegendsProps is the input to the BarLegends templ component.
type BarLegendsProps struct {
	Width   float64
	Height  float64
	Legends []LegendWithData
}

// BarLegends renders each legend box via legends.BoxLegendSvg. Mirrors
// @nivo/bar BarLegends. Series toggle (hx-post) is wired through the
// LegendProps.Toggle/ChartID fields set by UseBar.
templ BarLegends(props BarLegendsProps) {
	for _, lw := range props.Legends {
		{{ lp := lw.Props.LegendProps }}
		{{ items := legendItems(lw.Data) }}
		@legends.BoxLegendSvg(legends.BoxLegendSvgProps{
			Props: legends.LegendProps{
				Anchor:            lp.Anchor,
				Direction:         lp.Direction,
				Items:             items,
				TranslateX:        lp.TranslateX,
				TranslateY:        lp.TranslateY,
				ItemDirection:     lp.ItemDirection,
				ItemWidth:         lp.ItemWidth,
				ItemHeight:        lp.ItemHeight,
				ItemOpacity:       lp.ItemOpacity,
				SymbolShape:       lp.SymbolShape,
				SymbolSize:        lp.SymbolSize,
				SymbolSpacing:     lp.SymbolSpacing,
				SymbolBorderColor: lp.SymbolBorderColor,
				SymbolBorderWidth: lp.SymbolBorderWidth,
				Toggle:            lp.Toggle,
				ChartID:           lp.ChartID,
			},
			ChartWidth:  props.Width,
			ChartHeight: props.Height,
		})
	}
}
