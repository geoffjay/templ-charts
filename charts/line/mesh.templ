package line

import "fmt"

// MeshProps is the input to the Mesh templ component. The overlay is a single
// transparent <rect> that captures mouse position: client-hover resolves the
// nearest point (a voronoi cell) in the browser off data-tc-mesh; otherwise the
// htmx server round-trip resolves it. When Debug is true, the accurate voronoi
// cells (DebugCells) are drawn faintly beneath the capture rect — or, absent
// client points, the overlay gets a red stroke so its bounds are visible.
type MeshProps struct {
	Width   float64
	Height  float64
	Debug   bool
	ChartID string
	// DataMesh, when non-empty, is a JSON array of {x,y,html} points the client
	// interactivity layer (charts/interact) uses for nearest-point hover +
	// crosshair. When set, the htmx mesh round-trip is suppressed.
	DataMesh string
	// DetectionRadius, when > 0, is emitted as data-tc-mesh-radius so the client
	// ignores points farther than this from the cursor (nivo's detectionRadius).
	DetectionRadius float64
	// DebugCells, when non-empty, is the voronoi cell path drawn faintly under
	// the capture rect so the accurate detection partition is visible in debug.
	DebugCells string
}

// Mesh renders a transparent overlay <rect> for hover capture (plus the debug
// voronoi cells when enabled). Mirrors @nivo/line Mesh; the voronoi partition
// is computed server-side via internal/d3/delaunay.
//
// hx-vals converts the cursor's screen position into the rect's local SVG user
// coordinates via the rect's screen CTM. Because the rect lives inside the
// margin-translated <g> and shares the chart's coordinate system, the result is
// already in inner-chart units (0..innerWidth/Height) — matching the computed
// point coordinates the server compares against. Using getScreenCTM (rather
// than event.offsetX/offsetY) is correct under viewBox scaling and avoids the
// cross-browser inconsistencies of offsetX/offsetY on SVG elements.
templ Mesh(props MeshProps) {
	if props.DebugCells != "" {
		<path d={ props.DebugCells } fill="none" stroke="red" stroke-width="1" stroke-opacity="0.35"></path>
	}
	<rect
		x="0"
		y="0"
		width={ fmtL(props.Width) }
		height={ fmtL(props.Height) }
		fill="black"
		fill-opacity="0"
		if props.Debug && props.DebugCells == "" {
			stroke="red"
			stroke-width="1"
			stroke-opacity="0.5"
		}
		if props.DataMesh != "" {
			data-tc-mesh={ props.DataMesh }
			if props.DetectionRadius > 0 {
				data-tc-mesh-radius={ fmtL(props.DetectionRadius) }
			}
		}
		else
		if props.ChartID != "" {
			hx-get={ fmt.Sprintf("/charts/%s/hover?mesh=1", props.ChartID) }
			hx-trigger="mouseenter, mousemove throttle:40ms"
			hx-swap="innerHTML"
			hx-target={ fmt.Sprintf("#tooltip-%s", props.ChartID) }
			hx-vals={ meshHoverVals }
		}
	></rect>
}

// meshHoverVals is the htmx hx-vals JS expression that resolves the cursor's
// position in the mesh rect's local SVG user coordinates (inner-chart units).
// It maps the screen point through the rect's inverse screen CTM, which is
// correct under viewBox scaling; it falls back to offsetX/offsetY when the CTM
// is unavailable. The point is cached on event._tcPt so the y expression
// reuses the x expression's computation.
const meshHoverVals = "js:{" +
	"x: (event._tcPt = (function(e){" +
	"var r=e.target,s=r.ownerSVGElement,m=r.getScreenCTM&&r.getScreenCTM();" +
	"if(!s||!m){return {x:e.offsetX,y:e.offsetY};}" +
	"var p=s.createSVGPoint();p.x=e.clientX;p.y=e.clientY;" +
	"return p.matrixTransform(m.inverse());" +
	"})(event), Math.round(event._tcPt.x)), " +
	"y: Math.round(event._tcPt.y)}"
