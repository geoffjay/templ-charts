package line

import "fmt"

// LinesItemProps is the input to the LinesItem templ component. Mirrors
// @nivo/line LinesItem (SVG subset).
type LinesItemProps struct {
	Points        []PointXY
	LineGenerator LineGenerator
	Color         string
	Thickness     float64
	// Animate, when true, emits a SMIL <animate> on attributeName="d" growing
	// the line from an empty path to the full path (nivo's enter phase).
	Animate bool
}

// fmtL formats a float for SVG output (3 dp, trimmed).
func fmtL(v float64) string {
	if v != v || v > 1e308 {
		return "0"
	}
	return fmt.Sprintf("%.3g", v)
}

// LinesItem renders a single line as an SVG <path>. Mirrors @nivo/line
// LinesItem (minus spring animation — replaced by optional SMIL <animate>).
templ LinesItem(props LinesItemProps) {
	{{ path := props.LineGenerator(props.Points) }}
	<path d={ path } fill="none" stroke={ props.Color } stroke-width={ fmtL(props.Thickness) }>
		if props.Animate {
			<animate attributeName="d" from="M0,0" to={ path } begin="0s" dur="0.6s" fill="freeze"></animate>
		}
	</path>
}

// LinesProps is the input to the Lines templ component.
type LinesProps struct {
	Series        []ComputedSeries
	LineGenerator LineGenerator
	LineWidth     float64
	Animate       bool
}

// Lines renders all lines (reversed, so lower series draw on top). Mirrors
// @nivo/line Lines.
templ Lines(props LinesProps) {
	{{ reversed := reverseSeries(props.Series) }}
	for _, s := range reversed {
		@LinesItem(LinesItemProps{
			Points:        seriesPoints(s),
			LineGenerator: props.LineGenerator,
			Color:         s.Color,
			Thickness:     props.LineWidth,
			Animate:       props.Animate,
		})
	}
}
